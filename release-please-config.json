{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "bootstrap-sha": "633cc0e169581af9081385c76f9b23614dc2ba00",
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(release): release v${version}",
      "include-component-in-tag": false
    }
  },
  "changelog-sections": [
        {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Internal",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "Internal",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Internal",
      "hidden": false
    },
    {
      "type": "test",
      "section": "Internal",
      "hidden": false
    },
     {
      "type": "build",
      "section": "Internal",
      "hidden": false
    }
  ]
}